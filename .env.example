# Google Sheets Configuration (STRICTLY READ-ONLY)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEET_TAB_NAME=AppSheet_Survey

# Google OAuth 2.0 Credentials & Token Paths (relative to project root or absolute)
GOOGLE_CREDENTIALS_FILE=credentials/credentials.json
GOOGLE_TOKEN_FILE=credentials/token.json
# Optional: separate read-only service account JSON for Sheets (leave empty to use OAuth token.json)
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=

# Email Transport: 'gmail_api' (OAuth 2.0) or 'smtp' (SMTP + App Password with IMAP thread lookup)
EMAIL_TRANSPORT=smtp

# Gmail / Thread Configuration
GMAIL_THREAD_ID=your_existing_gmail_thread_id_here
# Optional (for SMTP transport): match existing thread by subject or explicit Message-ID
SMTP_THREAD_SUBJECT=
SMTP_THREAD_MESSAGE_ID=

# SMTP Settings (used when EMAIL_TRANSPORT=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_sender_email@example.com
SMTP_PASSWORD=your_gmail_app_password
SENDER_EMAIL=your_sender_email@example.com
RECIPIENT_EMAILS=recipient@example.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Gmail API Recipient Overrides (used when EMAIL_TRANSPORT=gmail_api; leave empty/'auto' to reply to thread)
EMAIL_TO=
EMAIL_CC=
EMAIL_SUBJECT_TEMPLATE=Daily Ward-wise CCMS Wattage Report – {date}
EMAIL_BODY_TEMPLATE=Please find attached the latest Ward-wise CCMS Wattage Report generated from the AppSheet_Survey Google Sheet.\n\nThe report contains consolidated CCMS-wise lamp counts for every ward, including dynamically detected wattage categories and total wattage calculations.\n\nRegards.

# Excel & Report Output
REPORT_WORKSHEET_NAME=CCMS_Wattage_Report
REPORT_FILENAME_TEMPLATE=Ward_Wise_CCMS_Report_{date}.xlsx
REPORTS_DIR=reports

# Logging & State
LOGS_DIR=logs
LOG_LEVEL=INFO
SEND_STATE_FILE=logs/send_state.json

# Scheduling & Timezone
TIMEZONE=Asia/Kolkata
CRON_SCHEDULE=0 9 * * *
